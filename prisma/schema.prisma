  dim_products     dim_products?     @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dim_projects     dim_projects?     @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  budget_versions  budget_versions   @relation(fields: [version_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([version_id, account_id, period_id, cost_center_id, department_id, project_id, product_id, location_id])
  @@schema("finance")
}

