  country       String? @db.VarChar(255)
  is_primary    Boolean @default(false)
  vendors       vendors @relation(fields: [vendor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([vendor_id, site_code])
  @@schema("finance")
}

model vendors {
  id              String         @id @default(dbgenerated("finance.uuid_v4()")) @db.Uuid
  bu_id           String         @db.Uuid
  vendor_no       String         @db.VarChar(255)
  name            String         @db.VarChar(255)
  tax_id          String?        @db.VarChar(255)
  currency_code   String         @db.Char(3)
  payment_term_id String?        @db.Uuid
  status          String         @default("ACTIVE") @db.VarChar(255)
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  ap_bills        ap_bills[]
  ap_payments     ap_payments[]
  vendor_sites    vendor_sites[]
  business_units  business_units @relation(fields: [bu_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  currencies      currencies     @relation(fields: [currency_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  payment_terms   payment_terms? @relation(fields: [payment_term_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([bu_id, vendor_no])
  @@schema("finance")
}

