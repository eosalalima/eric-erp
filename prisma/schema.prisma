  @@schema("finance")
}

model budget_lines {
  id               String            @id @default(dbgenerated("finance.uuid_v4()")) @db.Uuid
  version_id       String            @db.Uuid
  account_id       String            @db.Uuid
  period_id        String            @db.Uuid
  cost_center_id   String?           @db.Uuid
  department_id    String?           @db.Uuid
  project_id       String?           @db.Uuid
