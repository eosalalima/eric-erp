  suppliers                supply_suppliers           @relation(fields: [supplier_id], references: [supplier_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([supplier_id, period_start, period_end])
  @@index([period_start, period_end], map: "idx_supplier_score_period")
  @@schema("supply")
}

model supply_suppliers {
  supplier_id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  party_id             BigInt
  supplier_code        String                 @unique
  tax_country_code     String?
  status               String                 @default("active")
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  mrp_planned_orders   mrp_planned_orders[]
  purchase_orders      purchase_orders[]
  return_to_vendors    return_to_vendors[]
  rfq_suppliers        rfq_suppliers[]
  supplier_audits      supplier_audits[]
  supplier_contracts   supplier_contracts[]
  supplier_onboardings supplier_onboardings[]
  supplier_risks       supplier_risks[]
  supplier_scorecards  supplier_scorecards[]
  parties              parties                @relation(fields: [party_id], references: [party_id], onDelete: NoAction, onUpdate: NoAction)
  countries            countries?             @relation(fields: [tax_country_code], references: [country_code], onDelete: NoAction, onUpdate: NoAction)
  warranty_claims      warranty_claims[]

  @@map("suppliers")
  @@schema("supply")
}

model trade_declarations {
  declaration_id String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  declaration_no String     @unique
  direction      String
  shipment_id    String?    @db.Uuid
  country_code   String?
  submitted_at   DateTime?  @db.Timestamptz(6)
  status         String     @default("draft")
  documents      Json?
  countries      countries? @relation(fields: [country_code], references: [country_code], onDelete: NoAction, onUpdate: NoAction)
  shipments      shipments? @relation(fields: [shipment_id], references: [shipment_id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("supply")
}

model warehouse_bins {
  bin_id                                                              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouse_id                                                        String                 @db.Uuid
  bin_code                                                            String
  bin_type                                                            String?
  is_active                                                           Boolean                @default(true)
  created_at                                                          DateTime               @default(now()) @db.Timestamptz(6)
  kanban_cards_kanban_cards_source_bin_idTowarehouse_bins             kanban_cards[]         @relation("kanban_cards_source_bin_idTowarehouse_bins")
  kanban_cards_kanban_cards_target_bin_idTowarehouse_bins             kanban_cards[]         @relation("kanban_cards_target_bin_idTowarehouse_bins")
  prod_material_issues                                                prod_material_issues[]
  prod_receipts                                                       prod_receipts[]
  inventory_balances                                                  inventory_balances[]
  inventory_movements_inventory_movements_from_bin_idTowarehouse_bins inventory_movements[]  @relation("inventory_movements_from_bin_idTowarehouse_bins")
  inventory_movements_inventory_movements_to_bin_idTowarehouse_bins   inventory_movements[]  @relation("inventory_movements_to_bin_idTowarehouse_bins")
  pick_task_lines                                                     pick_task_lines[]
  putaway_task_lines                                                  putaway_task_lines[]
  receipt_lines                                                       receipt_lines[]
  stock_count_lines                                                   stock_count_lines[]
  warehouses                                                          warehouses             @relation(fields: [warehouse_id], references: [warehouse_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([warehouse_id, bin_code])
  @@schema("supply")
}

model warehouses {
  warehouse_id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wh_code              String                 @unique
  wh_name              String
  address_id           BigInt?
  timezone             String?                @default("Asia/Manila")
  is_active            Boolean                @default(true)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  prod_material_issues prod_material_issues[]
  prod_receipts        prod_receipts[]
  production_orders    production_orders[]
  delivery_notes       delivery_notes[]
  sales_order_lines    sales_order_lines[]
  customer_rmas        customer_rmas[]
  demand_forecasts     demand_forecasts[]
  inventory_balances   inventory_balances[]
  inventory_movements  inventory_movements[]
  mrp_planned_orders   mrp_planned_orders[]
  pick_tasks           pick_tasks[]
  putaway_tasks        putaway_tasks[]
  receipts             supply_receipts[]
  return_to_vendors    return_to_vendors[]
  shipments            shipments[]
  stock_counts         stock_counts[]
  warehouse_bins       warehouse_bins[]
  addresses            addresses?             @relation(fields: [address_id], references: [address_id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("supply")
}

model warranty_claims {
  warranty_claim_id String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  claim_no          String            @unique
  supplier_id       String?           @db.Uuid
  item_id           String?           @db.Uuid
  claim_date        DateTime          @db.Date
  description       String?
  status            String            @default("open")
  items             items?            @relation(fields: [item_id], references: [item_id], onDelete: NoAction, onUpdate: NoAction)
  suppliers         supply_suppliers? @relation(fields: [supplier_id], references: [supplier_id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("supply")
}
