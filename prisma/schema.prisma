generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["finance", "public"]
}

model user {
  id        String   @id(map: "User_pkey") @db.Uuid
  email     String   @unique(map: "User_email_key")
  roleId    Int
  clerkId   String
  firstName String?
  lastName  String?
  firstTime Boolean? @default(true)

  @@schema("public")
}

model navigation {
  id             String          @id(map: "Navigation_pkey") @db.Uuid
  applicationId  Int
  navigationName String
  href           String
  icon           String
  current        Boolean
  sortOrder      Int?
  subnavigation  subnavigation[]

  @@schema("public")
}

model subnavigation {
  id                String     @id @unique(map: "idx_id") @db.Uuid
  navigationId      String     @db.Uuid
  subNavigationName String
  href              String
  icon              String?
  current           Boolean?
  sortOrder         Int?
  navigation        navigation @relation(fields: [navigationId], references: [id], onUpdate: Restrict, map: "fk_navigation_navigationId")

  @@schema("public")
}

model accounts {
  id             String          @id @default(dbgenerated("finance.uuid_v4()")) @db.Uuid
  ledger_id      String          @db.Uuid
  code           String          @db.VarChar(255)
  name           String          @db.VarChar(255)
  description    String?
  level          Int             @default(1)
  parent_id      String?         @db.Uuid
  type           account_type
  normal_balance normal_balance
  is_postable    Boolean         @default(true)
  status         String          @default("ACTIVE") @db.VarChar(255)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @default(now()) @db.Timestamptz(6)
  ledgers        ledgers         @relation(fields: [ledger_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  accounts       accounts?       @relation("accountsToaccounts", fields: [parent_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  other_accounts accounts[]      @relation("accountsToaccounts")
  budget_lines   budget_lines[]
  gl_balances    gl_balances[]
  journal_lines  journal_lines[]

  @@unique([ledger_id, code])
  @@schema("finance")
}

model ap_bill_lines {
  id                 String            @id @default(dbgenerated("finance.uuid_v4()")) @db.Uuid
  bill_id            String            @db.Uuid
  line_no            Int
  item_code          String?           @db.VarChar(255)
  description        String
  quantity           Decimal           @default(1) @db.Decimal(18, 4)
  unit_price         Decimal           @default(0) @db.Decimal(18, 4)
  line_subtotal      Decimal           @default(0) @db.Decimal(18, 4)
  tax_code_id        String?           @db.Uuid
  tax_amount         Decimal           @default(0) @db.Decimal(18, 4)
  line_total         Decimal           @default(0) @db.Decimal(18, 4)
  expense_account_id String?           @db.Uuid
  cost_center_id     String?           @db.Uuid
  project_id         String?           @db.Uuid
  ap_bills           ap_bills          @relation(fields: [bill_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dim_cost_centers   dim_cost_centers? @relation(fields: [cost_center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dim_projects       dim_projects?     @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([bill_id, line_no])
  @@schema("finance")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ap_bills {
  id                      String                    @id @default(dbgenerated("finance.uuid_v4()")) @db.Uuid
  bu_id                   String                    @db.Uuid
  vendor_id               String                    @db.Uuid
  bill_no                 String                    @db.VarChar(255)
  bill_date               DateTime                  @db.Date
  due_date                DateTime                  @db.Date
  currency_code           String                    @db.Char(3)
  exchange_rate           Decimal                   @default(1.0) @db.Decimal(18, 8)
  subtotal_amount         Decimal                   @default(0) @db.Decimal(18, 4)
  tax_amount              Decimal                   @default(0) @db.Decimal(18, 4)
  total_amount            Decimal                   @default(0) @db.Decimal(18, 4)
  status                  doc_status                @default(DRAFT)
  description             String?
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  posted_journal_id       String?                   @db.Uuid
  ap_bill_lines           ap_bill_lines[]
  business_units          business_units            @relation(fields: [bu_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  currencies              currencies                @relation(fields: [currency_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  journals                journals?                 @relation(fields: [posted_journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendors                 vendors                   @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ap_payment_applications ap_payment_applications[]

  @@unique([bu_id, bill_no])
  @@schema("finance")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ap_payment_applications {
  id             String      @id @default(dbgenerated("finance.uuid_v4()")) @db.Uuid
  payment_id     String      @db.Uuid
  bill_id        String      @db.Uuid
  applied_amount Decimal     @db.Decimal(18, 4)
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  ap_bills       ap_bills    @relation(fields: [bill_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ap_payments    ap_payments @relation(fields: [payment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([payment_id, bill_id])
  @@schema("finance")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ap_payments {
  id                      String                    @id @default(dbgenerated("finance.uuid_v4()")) @db.Uuid
  bu_id                   String                    @db.Uuid
  payment_no              String                    @db.VarChar(255)
  payment_date            DateTime                  @db.Date
  vendor_id               String                    @db.Uuid
  payment_type            ap_payment_type           @default(PAYMENT)
  method                  payment_method
  currency_code           String                    @db.Char(3)
  amount                  Decimal                   @db.Decimal(18, 4)
  unapplied_amount        Decimal                   @default(0) @db.Decimal(18, 4)
  status                  doc_status                @default(DRAFT)
  reference               String?                   @db.VarChar(255)
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  posted_journal_id       String?                   @db.Uuid
  ap_payment_applications ap_payment_applications[]
  business_units          business_units            @relation(fields: [bu_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  currencies              currencies                @relation(fields: [currency_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  journals                journals?                 @relation(fields: [posted_journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendors                 vendors                   @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([bu_id, payment_no])
  @@schema("finance")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model approvals {
  id        String    @id @default(dbgenerated("finance.uuid_v4()")) @db.Uuid
