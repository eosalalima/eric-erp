generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Navigation {
  id             String  @id @db.Uuid
  roleId         Int 
  navigationName String
  href           String
  icon           String
  current        Boolean
  sortOrder      Int     @map("order") // DB column is "order", Prisma field is sortOrder

  @@map("Navigation")
}

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  roleId    Int
  clerkId   String
  firstName String?
  lastName  String?
  firstTime Boolean? @default(true)
}
