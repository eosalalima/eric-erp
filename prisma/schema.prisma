generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["administration", "business_intel", "compliance", "customer", "ecommerce", "finance", "human", "manufacturing", "product", "project", "public", "sales", "supply"]
}

model addresses {
  address_id                                                    BigInt                  @id @default(autoincrement())
  party_id                                                      BigInt?
  attention_to                                                  String?
  line1                                                         String
  line2                                                         String?
  city                                                          String?
  subdivision_id                                                BigInt?
  postal_code                                                   String?
  country_id                                                    BigInt?
  latitude                                                      Decimal?                @db.Decimal(10, 6)
  longitude                                                     Decimal?                @db.Decimal(10, 6)
  created_at                                                    DateTime                @default(now()) @db.Timestamptz(6)
  countries                                                     countries?              @relation(fields: [country_id], references: [country_id], onDelete: NoAction, onUpdate: NoAction)
  parties                                                       parties?                @relation(fields: [party_id], references: [party_id], onUpdate: NoAction)
  country_subdivisions                                          country_subdivisions?   @relation(fields: [subdivision_id], references: [subdivision_id], onDelete: NoAction, onUpdate: NoAction)
  account_addresses                                             account_addresses[]
  cart_shipments                                                cart_shipments[]
  order_addresses                                               order_addresses[]
  portal_user_addresses                                         portal_user_addresses[]
  fixed_assets                                                  fixed_assets[]
  plants                                                        plants[]
  project_sites                                                 project_sites[]
  sales_orders_sales_orders_bill_to_address_idToaddresses       sales_orders[]          @relation("sales_orders_bill_to_address_idToaddresses")
  sales_orders_sales_orders_ship_to_address_idToaddresses       sales_orders[]          @relation("sales_orders_ship_to_address_idToaddresses")
  freight_rates_freight_rates_destination_address_idToaddresses freight_rates[]         @relation("freight_rates_destination_address_idToaddresses")
  freight_rates_freight_rates_origin_address_idToaddresses      freight_rates[]         @relation("freight_rates_origin_address_idToaddresses")
  purchase_orders                                               purchase_orders[]
  rfq_quotes                                                    rfq_quotes[]
  warehouses                                                    warehouses[]

  @@index([party_id], map: "idx_addresses_party")
  @@schema("administration")
}

model api_keys {
  api_key_id    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label         String
  org_id        BigInt?
  user_id       BigInt?
  key_hash      String
  scopes        String[]
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  revoked_at    DateTime?      @db.Timestamptz(6)
  organizations organizations? @relation(fields: [org_id], references: [org_id], onDelete: NoAction, onUpdate: NoAction)
  users         users?         @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("administration")
}

model approval_policies {
  approval_policy_id    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                  String                  @unique
  name                  String
  applies_to_module     String
  applies_to_entity     String
  conditions            Json?
  is_active             Boolean                 @default(true)
  approval_policy_steps approval_policy_steps[]

  @@schema("administration")
}

model approval_policy_steps {
  approval_policy_step_id String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  approval_policy_id      String            @db.Uuid
  step_no                 Int
  approver_type           String
  approver_ref            String?
  sla_minutes             Int?
  approval_policies       approval_policies @relation(fields: [approval_policy_id], references: [approval_policy_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([approval_policy_id, step_no])
  @@schema("administration")
}

model administration_attachments {
  attachment_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  file_id       String   @db.Uuid
  module        String
  entity        String
  entity_id     String   @db.Uuid
  caption       String?
  attached_at   DateTime @default(now()) @db.Timestamptz(6)
  attached_by   BigInt?
  users         users?   @relation(fields: [attached_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  files         files    @relation(fields: [file_id], references: [file_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("attachments")
  @@schema("administration")
}

model audit_logs {
  audit_log_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurred_at  DateTime @default(now()) @db.Timestamptz(6)
  user_id      BigInt?
  module       String
  entity       String
  entity_id    String?  @db.Uuid
  action       String
  before_data  Json?
  after_data   Json?
  metadata     Json?
  users        users?   @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([occurred_at], map: "idx_audit_time")
  @@schema("administration")
}

model calendars {
  calendar_id  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String      @unique
  name         String
  country_id   BigInt?
  time_zone_id BigInt?
  description  String?
  countries    countries?  @relation(fields: [country_id], references: [country_id], onDelete: NoAction, onUpdate: NoAction)
  time_zones   time_zones? @relation(fields: [time_zone_id], references: [time_zone_id], onDelete: NoAction, onUpdate: NoAction)
  holidays     holidays[]

  @@schema("administration")
}

model cost_centers {
  cost_center_id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id                BigInt?
  code                  String
  name                  String
  parent_cost_center_id String?        @db.Uuid
  status                String         @default("active")
  organizations         organizations? @relation(fields: [org_id], references: [org_id], onDelete: NoAction, onUpdate: NoAction)
  cost_centers          cost_centers?  @relation("cost_centersTocost_centers", fields: [parent_cost_center_id], references: [cost_center_id], onDelete: NoAction, onUpdate: NoAction)
  other_cost_centers    cost_centers[] @relation("cost_centersTocost_centers")

  @@unique([org_id, code])
  @@index([org_id], map: "idx_costcenter_org")
  @@schema("administration")
}

model countries {
  country_id           BigInt                 @id @default(autoincrement())
  country_code         String                 @unique
  name                 String
  addresses            addresses[]
  calendars            calendars[]
  country_subdivisions country_subdivisions[]
  organizations        organizations[]
  tax_schemes          tax_schemes[]
  suppliers            supply_suppliers[]
  trade_declarations   trade_declarations[]

  @@schema("administration")
}

model country_subdivisions {
  subdivision_id BigInt      @id @default(autoincrement())
  country_id     BigInt
  code           String
  name           String
  addresses      addresses[]
  countries      countries   @relation(fields: [country_id], references: [country_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([country_id, code])
  @@schema("administration")
}

model currencies {
  currency_id          BigInt                 @id @default(autoincrement())
  currency_code        String                 @unique
  name                 String
  symbol               String?
  minor_unit           Int?                   @default(2) @db.SmallInt
  organizations        organizations[]
  accounts             accounts[]
  opportunities        opportunities[]
  carts                carts[]
  order_payments       order_payments[]
  orders               orders[]
  payment_intents      payment_intents[]
  payment_transactions payment_transactions[]
  storefront_variants  storefront_variants[]
  storefronts          storefronts[]
  ap_invoices          ap_invoices[]
  ar_invoices          ar_invoices[]
  bank_accounts        bank_accounts[]
  budgets              budgets[]
  journal_entries      journal_entries[]
  journal_lines        journal_lines[]
  ledger_accounts      ledger_accounts[]
  payments             payments[]
  receipts             finance_receipts[]
  tax_schemes          tax_schemes[]
  cost_transactions    cost_transactions[]
  item_standard_costs  item_standard_costs[]
  resources            resources[]
  catalogs             catalogs[]
  plan_addons          plan_addons[]
  product_cost_refs    product_cost_refs[]
  product_price_guides product_price_guides[]
  products             products[]
  service_plans        service_plans[]
  contract_milestones  contract_milestones[]
  project_budgets      project_budgets[]
  project_contracts    project_contracts[]
  project_expenses     project_expenses[]
  projects             projects[]
  price_agreements     price_agreements[]
  price_list_items     price_list_items[]
  price_lists          price_lists[]
  quotations           quotations[]
  sales_orders         sales_orders[]
  freight_contracts    freight_contracts[]
  freight_settlements  freight_settlements[]
  purchase_orders      purchase_orders[]
  rfq_quote_lines      rfq_quote_lines[]
  rfqs                 rfqs[]
  supplier_contracts   supplier_contracts[]

  @@schema("administration")
}

model department_members {
  department_member_id String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  department_id        String      @db.Uuid
  user_id              BigInt?
  from_date            DateTime?   @db.Date
  to_date              DateTime?   @db.Date
  departments          departments @relation(fields: [department_id], references: [department_id], onDelete: Cascade, onUpdate: NoAction)
  users                users?      @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([department_id, user_id, from_date])
  @@schema("administration")
}

model departments {
  department_id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id               BigInt?
  code                 String
  name                 String
  parent_department_id String?              @db.Uuid
  department_members   department_members[]
  organizations        organizations?       @relation(fields: [org_id], references: [org_id], onDelete: NoAction, onUpdate: NoAction)
  departments          departments?         @relation("departmentsTodepartments", fields: [parent_department_id], references: [department_id], onDelete: NoAction, onUpdate: NoAction)
  other_departments    departments[]        @relation("departmentsTodepartments")

  @@unique([org_id, code])
  @@index([org_id], map: "idx_dept_org")
  @@schema("administration")
}

model document_categories {
  doc_category_id BigInt           @id @default(autoincrement())
  code            String           @unique
  name            String
  document_types  document_types[]

  @@schema("administration")
}

model document_types {
  doc_type_id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doc_category_id     BigInt?
  code                String                @unique
  name                String
  description         String?
  document_categories document_categories?  @relation(fields: [doc_category_id], references: [doc_category_id], onDelete: NoAction, onUpdate: NoAction)
  numbering_sequences numbering_sequences[]

  @@schema("administration")
}

model files {
  file_id          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  file_key         String                       @unique
  filename         String
  content_type     String?
  byte_size        BigInt?
  checksum         String?
  storage_provider String                       @default("s3")
  created_by       BigInt?
  created_at       DateTime                     @default(now()) @db.Timestamptz(6)
  attachments      administration_attachments[]
  users            users?                       @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "idx_files_created")
  @@schema("administration")
}

model generic_reasons {
  reason_id BigInt @id @default(autoincrement())
  domain    String
  code      String
  name      String

  @@unique([domain, code])
  @@schema("administration")
}

model generic_statuses {
  status_id BigInt @id @default(autoincrement())
  domain    String
  code      String
  name      String

  @@unique([domain, code])
  @@schema("administration")
}

model holidays {
  holiday_id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  calendar_id  String    @db.Uuid
  holiday_date DateTime  @db.Date
  name         String
  is_recurring Boolean   @default(false)
  calendars    calendars @relation(fields: [calendar_id], references: [calendar_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([calendar_id, holiday_date, name])
  @@schema("administration")
}

model integration_endpoints {
  endpoint_id   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id        BigInt?
  code          String         @unique
  base_url      String?
  auth_type     String?
  config        Json?
  organizations organizations? @relation(fields: [org_id], references: [org_id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("administration")
}

model languages {
  language_id BigInt @id @default(autoincrement())
  lang_code   String @unique
  name        String

  @@schema("administration")
}

model notification_channels {
  notif_channel_id       BigInt                                  @id @default(autoincrement())
  code                   String                                  @unique
  name                   String
  notification_templates administration_notification_templates[]

  @@schema("administration")
}

model administration_notification_templates {
  notif_template_id     String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                  String                         @unique
  name                  String
  channel_code          String
  subject               String?
  body                  String?
  locale                String?
  notification_channels notification_channels          @relation(fields: [channel_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  notifications         administration_notifications[]

  @@map("notification_templates")
  @@schema("administration")
}

model administration_notifications {
  notification_id        String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notif_template_id      String?                                @db.Uuid
  recipient_user_id      BigInt?
  recipient_address      String?
  sent_at                DateTime?                              @db.Timestamptz(6)
  status                 String                                 @default("queued")
  payload                Json?
  notification_templates administration_notification_templates? @relation(fields: [notif_template_id], references: [notif_template_id], onDelete: NoAction, onUpdate: NoAction)
  users                  users?                                 @relation(fields: [recipient_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("notifications")
  @@schema("administration")
}

model numbering_locks {
  lock_id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sequence_id         String              @db.Uuid
  locked_at           DateTime            @default(now()) @db.Timestamptz(6)
  locked_by           BigInt?
  users               users?              @relation(fields: [locked_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  numbering_sequences numbering_sequences @relation(fields: [sequence_id], references: [sequence_id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("administration")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model numbering_sequences {
  sequence_id     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id          BigInt?
  doc_type_id     String?           @db.Uuid
  code            String            @unique
  pattern         String
  next_value      BigInt            @default(1)
  min_value       BigInt            @default(1)
  max_value       BigInt?
  reset_policy    String            @default("yearly")
  last_reset_at   DateTime?         @db.Timestamptz(6)
  is_active       Boolean           @default(true)
  numbering_locks numbering_locks[]
  document_types  document_types?   @relation(fields: [doc_type_id], references: [doc_type_id], onDelete: NoAction, onUpdate: NoAction)
  organizations   organizations?    @relation(fields: [org_id], references: [org_id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("administration")
}

model organizations {
  org_id                BigInt                  @id @default(autoincrement())
  party_id              BigInt?
  org_code              String                  @unique
  legal_name            String
  tax_id                String?
  country_id            BigInt?
  time_zone_id          BigInt?
  base_currency_code    String?
  active                Boolean                 @default(true)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  api_keys              api_keys[]
  cost_centers          cost_centers[]
  departments           departments[]
  integration_endpoints integration_endpoints[]
  numbering_sequences   numbering_sequences[]
  currencies            currencies?             @relation(fields: [base_currency_code], references: [currency_code], onDelete: NoAction, onUpdate: NoAction)
  countries             countries?              @relation(fields: [country_id], references: [country_id], onDelete: NoAction, onUpdate: NoAction)
  parties               parties?                @relation(fields: [party_id], references: [party_id], onDelete: NoAction, onUpdate: NoAction)
  time_zones            time_zones?             @relation(fields: [time_zone_id], references: [time_zone_id], onDelete: NoAction, onUpdate: NoAction)
  settings              settings[]
  role_assignments      role_assignments[]
  assets                compliance_assets[]
  audit_programs        audit_programs[]
  controls              controls[]
  data_subject_requests data_subject_requests[]
  exceptions            exceptions[]
  incidents             incidents[]
  policies              policies[]
  processing_activities processing_activities[]
  risks                 compliance_risks[]
  vendors               vendors[]
  accounts              accounts[]
  activities            activities[]
  campaigns             campaigns[]
  cases                 cases[]
  leads                 leads[]
  opportunities         opportunities[]
  slas                  slas[]
  surveys               surveys[]
  territories           territories[]
  purchase_requisitions purchase_requisitions[]

  @@schema("administration")
}

model parties {
  party_id              BigInt                  @id @default(autoincrement())
  party_type            String
  display_name          String
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  addresses             addresses[]
  organizations         organizations[]
  persons               persons?
  users                 users[]
  data_subject_requests data_subject_requests[]
  vendors               vendors[]
  customers             customers[]
  journal_lines         journal_lines[]
  finance_suppliers     finance_suppliers[]
  programs              programs[]
  project_stakeholders  project_stakeholders[]
  projects              projects[]
  carriers              carriers[]
  dpl_matches           dpl_matches[]
  supply_suppliers      supply_suppliers[]

  @@schema("administration")
}

model permissions {
  permission_id    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String             @unique
  name             String
  description      String?
  role_permissions role_permissions[]

  @@schema("administration")
}

model persons {
  person_id   BigInt    @id @default(autoincrement())
  party_id    BigInt    @unique
  given_name  String?
  middle_name String?
  family_name String?
  birth_date  DateTime? @db.Date
  gender      String?
  parties     parties   @relation(fields: [party_id], references: [party_id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("administration")
}

model role_permissions {
  role_permission_id String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id            String               @db.Uuid
  permission_id      String               @db.Uuid
  permissions        permissions          @relation(fields: [permission_id], references: [permission_id], onDelete: Cascade, onUpdate: NoAction)
  roles              administration_roles @relation(fields: [role_id], references: [role_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([role_id, permission_id])
  @@schema("administration")
}

model administration_roles {
  role_id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String             @unique
  name             String
  description      String?
  role_permissions role_permissions[]
  user_roles       user_roles[]
  workflow_tasks   workflow_tasks[]

  @@map("roles")
  @@schema("administration")
}

model settings {
  setting_id    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id        BigInt?
  key           String
  value         String?
  is_secret     Boolean        @default(false)
  organizations organizations? @relation(fields: [org_id], references: [org_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([org_id, key])
  @@schema("administration")
}

model time_zones {
  time_zone_id  BigInt          @id @default(autoincrement())
  tz_name       String          @unique
  calendars     calendars[]
  organizations organizations[]
  users         users[]

  @@schema("administration")
}

model units_of_measure {
  uom_id                     BigInt                       @id @default(autoincrement())
  uom_code                   String                       @unique
  name                       String
  category                   String?
  base_factor                Decimal?                     @default(1) @db.Decimal(18, 6)
  cart_items                 cart_items[]
  ap_invoice_lines           ap_invoice_lines[]
  ar_invoice_lines           ar_invoice_lines[]
  bom_lines                  bom_lines[]
  prod_material_issues       prod_material_issues[]
  prod_material_reservations prod_material_reservations[]
  prod_receipts              prod_receipts[]
  production_orders          production_orders[]
  quality_check_types        quality_check_types[]
  attribute_definitions      attribute_definitions[]
  bundle_items               bundle_items[]
  plan_components            plan_components[]
  products                   products[]
  delivery_note_lines        delivery_note_lines[]
  price_agreement_lines      price_agreement_lines[]
  price_list_items           price_list_items[]
  quotation_lines            quotation_lines[]
  sales_order_lines          sales_order_lines[]
  inventory_movements        inventory_movements[]
  items                      items[]
  mrp_planned_orders         mrp_planned_orders[]
  pick_task_lines            pick_task_lines[]
  purchase_order_lines       purchase_order_lines[]
  purchase_requisition_lines purchase_requisition_lines[]
  quality_criteria           quality_criteria[]
  receipt_lines              receipt_lines[]
  rfq_lines                  rfq_lines[]
  shipment_lines             shipment_lines[]

  @@schema("administration")
}

model user_identities {
  user_identity_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          BigInt
  idp_code         String
  subject          String
  attributes       Json?
  users            users  @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([idp_code, subject])
  @@unique([user_id, idp_code])
  @@schema("administration")
}

model user_roles {
  user_role_id                        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                             BigInt
  role_id                             String               @db.Uuid
  assigned_at                         DateTime             @default(now()) @db.Timestamptz(6)
  assigned_by                         BigInt?
  users_user_roles_assigned_byTousers users?               @relation("user_roles_assigned_byTousers", fields: [assigned_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  roles                               administration_roles @relation(fields: [role_id], references: [role_id], onDelete: Cascade, onUpdate: NoAction)
  users_user_roles_user_idTousers     users                @relation("user_roles_user_idTousers", fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, role_id])
  @@schema("administration")
}

model users {
  user_id                                       BigInt                         @id @default(autoincrement())
  party_id                                      BigInt?
  username                                      String?                        @unique
  email                                         String                         @unique
  email_verified                                Boolean                        @default(false)
  phone                                         String?
  status                                        String                         @default("active")
  locale                                        String?                        @default("en-PH")
  time_zone_id                                  BigInt?
  password_hash                                 String?
  created_at                                    DateTime                       @default(now()) @db.Timestamptz(6)
  last_login_at                                 DateTime?                      @db.Timestamptz(6)
  api_keys                                      api_keys[]
  admin_attachments                             administration_attachments[]
  audit_logs                                    audit_logs[]
  department_members                            department_members[]
  files                                         files[]
  notifications                                 administration_notifications[]
  numbering_locks                               numbering_locks[]
  user_identities                               user_identities[]
  user_roles_user_roles_assigned_byTousers      user_roles[]                   @relation("user_roles_assigned_byTousers")
  user_roles_user_roles_user_idTousers          user_roles[]                   @relation("user_roles_user_idTousers")
  parties                                       parties?                       @relation(fields: [party_id], references: [party_id], onDelete: NoAction, onUpdate: NoAction)
  time_zones                                    time_zones?                    @relation(fields: [time_zone_id], references: [time_zone_id], onDelete: NoAction, onUpdate: NoAction)
